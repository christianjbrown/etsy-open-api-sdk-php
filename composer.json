{
    "name": "christianjbrown/etsy-open-api-sdk-php",
    "require": {
        "php": "^8.2",
        "christianjbrown/json-api-client": "dev-main",
        "christianjbrown/key-value-store": "dev-main",
        "christianjbrown/oauth2-client": "dev-main",
        "christianjbrown/user-friendly-exception": "dev-main",
        "psr/http-client": "^1.0",
        "symfony/dependency-injection": "7.1.x-dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0@dev",
        "christianjbrown/phpcs-wrapper": "dev-main",
        "christianjbrown/php-cs-fixer-wrapper": "dev-main"
    },
    "minimum-stability": "dev",
    "config": {
        "bin-dir": "bin"
    },
    "autoload": {
        "psr-4": {
            "ChristianBrown\\Etsy\\": "src/",
            "ChristianBrown\\Etsy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "./bin/phpunit && open ./.phpunit.cache/code-coverage-html/index.html"
        ],
        "check-style": [
            "./bin/phpcs --standard=vendor/christianjbrown/phpcs-wrapper/standards/ChristianBrown/ruleset.xml ./src ./tests"
        ],
        "fix-style": [
            "./bin/php-cs-fixer fix ./src ./tests -vvv --config=vendor/christianjbrown/php-cs-fixer-wrapper/rule-sets/risky.php"
        ]
    },
    "repositories": [
        {
            "type": "github",
            "url": "git@github.com:christianjbrown/user-friendly-exception.git"
        },
        {
            "type": "github",
            "url": "git@github.com:christianjbrown/json-api-client.git"
        },
        {
            "type": "github",
            "url": "git@github.com:christianjbrown/oauth2-client.git"
        },
        {
            "type": "github",
            "url": "git@github.com:christianjbrown/key-value-store.git"
        },
        {
            "type": "github",
            "url": "git@github.com:christianjbrown/php-cs-fixer-wrapper.git"
        },
        {
            "type": "github",
            "url": "git@github.com:christianjbrown/phpcs-wrapper.git"
        },
        {
            "type": "github",
            "url": "git@github.com:christianjbrown/git-php-wrapper.git"
        }
    ]
}
